{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["master"],
  "branchPrefix": "security/renovate-",
  "forkProcessing": "enabled",
  "ignorePaths": ["**/node_modules/**"],
  "includePaths": [
    "package.json",
    "package-lock.json",
    "tests/trivy-fixture/package-lock.json",
    "tests/trivy-fixture/package.json"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "gitAuthor": "jarlley <jarlley@users.noreply.github.com>",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash"
}
