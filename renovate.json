{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["master"],
  "branchPrefix": "security/renovate-",
  "forkProcessing": "enabled",
  "includePaths": [
    "package.json",
    "package-lock.json",
    "tests/trivy-fixture/package-lock.json"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
